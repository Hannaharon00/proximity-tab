+require_relative './mixins/prompt'
+require_relative './rocket'
+
+class Mission
+  include Prompt
+
+  attr_reader :summary
+
+  def initialize
+    @summary = {
+      total_distance: 0.0,
+      no_abort_retries: 0,
+      no_explosions: 0,
+      total_fuel_burned: 0,
+      flight_time: 0.0
+    }
+
+    # @random_seed = random_seed
+    # @plan = {
+
+    # }
+  end
+
+  # def print_plan
+  def plan
+    # TODO: Make it dynamic
+    puts 'Mission plan:'
+    puts '  Travel distance: 160.0 km'
+    puts '  Payload capacity: 50,000 kg'
+    puts '  Fuel capacity: 1,514,100 liters'
+    puts '  Burn rate: 168,240 liters/min'
+    puts '  Average speed: 1,500 km/h'
+    puts "  Random seed: #{@random_seed}"
+    print 'What is the name of this mission? '
+    @mission_name = gets.chomp
+  end
+
+  def proceed?
+    prompt('Would you like to proceed?')
+  end
+
+  def start
+    rocket = Rocket.configure(
+      distance: 160,
+      burn_rate: 168_240,
+      average_speed: 1500
+    )
+
+    if rocket.launch?
+      rocket.launch do |status|
+        display_mission_status(status)
+      end
+    end
+
+    update_summary(rocket.summary)
+  end
+
+  private
+
+  def display_mission_status(**kwargs)
+    puts 'Mission status:'
+    puts "  Current fuel burn rate: #{kwargs[:current_fuel_burn_rate]} liters/min"
+    puts "  Current speed: #{kwargs[:current_speed]} km/h"
+    puts "  Current distance traveled: #{kwargs[:distance_traveled]} km"
+    puts "  Elapsed time: #{format_time(kwargs[:elapsed_time])}"
+    puts "  Time to destination: #{format_time(kwargs[:time_to_destination])}"
+  end
+
+  def format_time(time)
+    hours = time / 3600
+    minutes = (time % 3600) / 60
+    seconds = time % 60
+
+    format('%02d:%02d:%02d', hours, minutes, seconds)
+  end
+
+  def update_summary(**kwargs)
+    @summary = kwargs.slice(
+      :total_distance,
+      :no_abort_retries,
+      :no_explosions,
+      :total_fuel_burned,
+      :flight_time
+    )
+  end
+end
